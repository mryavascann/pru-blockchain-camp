// ============================================================================
// PRU Blockchain Kulübü — Veritabanı şeması
//
// TASARIM İLKESİ: Zincir ve veritabanı FARKLI şeyler tutar.
//
//   Zincir  → yapı ve yetki : kimin hangi rozeti var, kamplar, merkle root'lar
//   Veritabanı → içerik ve süreç : Notion metinleri, başvurular, onaylar, cache
//
// Bu ayrımı bozmamak kritik. Örneğin "alice 3. haftayı tamamladı" bilgisi
// veritabanında `WeeklyCompletion` olarak durur (senin onayınla), zincirde ise
// bir merkle root'un içinde durur. İkisi aynı şey değildir: DB "hak ediyor"
// der, zincir "aldı" der.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
//                                  KAMPLAR
// ============================================================================

/// Bir kamp programı. `id` alanı ZİNCİRDEKİ campId ile birebir aynıdır.
///
/// Neden otomatik artan id kullanmıyoruz: tokenId hesabı `(campId << 16) | week`
/// formülüne dayanıyor. Veritabanı ile zincir farklı campId'ler kullanırsa
/// yanlış rozet gösterilir. Bu yüzden id elle, zincirdeki değerle yazılır.
model Camp {
  /// Zincirdeki campId (1'den başlar)
  id Int @id

  /// URL'de kullanılan kısa ad: "developers", "directors"
  slug String @unique

  /// Görünen ad. Zincirdeki adla eşleşmeli (senkron admin panelinden yapılır).
  name String

  /// Landing ve müfredat sayfasında görünen kısa tanıtım. HERKESE AÇIK.
  description String?

  /// Zincirdeki weekCount ile eşleşmeli. Sadece artabilir.
  weekCount Int

  /// Kamp yeni rozet almaya açık mı (zincirdeki `active` ile eşleşmeli)
  active Boolean @default(true)

  /// HANGİ HAFTA HERKESE AÇIK OLACAK.
  /// Bu bir ERİŞİM KONTROLÜ kararıdır, içerik değil — bu yüzden Notion'da
  /// değil burada durur ve admin panelinden değiştirilir.
  /// null ise hiçbir hafta public değildir.
  publicWeekNumber Int?

  /// Bu kampın içeriğinin çekileceği Notion kaynağının kimliği.
  ///
  /// Şu an bir SAYFA kimliği (haftalar o sayfadaki iç içe toggle blokları).
  /// İleride yapı bir database'e taşınırsa aynı alan data source kimliğini
  /// tutar — ayrıştırıcı ikisini de destekleyecek şekilde yazıldı.
  notionSourceId String?

  /// Kampın başlangıç tarihi (bilgi amaçlı, hafta hesabında kullanılmaz)
  startDate DateTime?

  /// Koleksiyon kapak görselinin IPFS CID'i (`bafy...`, `ipfs://` öneksiz).
  /// OpenSea koleksiyon avatarı olarak kullanılır.
  coverCid String?

  /// Sıralama (landing sayfasında hangi kamp önce görünsün)
  displayOrder Int @default(0)

  weeks        Week[]
  applications Application[]
  completions  WeeklyCompletion[]
  merkleTrees  MerkleTree[]
  notes        WeekNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// ============================================================================
//                                  HAFTALAR
// ============================================================================

enum WeekStatus {
  /// Notion'da hazırlanıyor — sitede HİÇ görünmez
  DRAFT

  /// Yayında — müfredat listesinde görünür, içeriği erişim kurallarına tabi
  PUBLISHED
}

enum SyncStatus {
  /// Henüz hiç senkron edilmedi
  PENDING

  /// Son senkron başarılı
  OK

  /// Son senkron başarısız — İÇERİK SİLİNMEZ, eski hâli durur
  FAILED
}

/// Bir kampın bir haftası. İçeriği Notion'dan senkronlanır.
///
/// ⚠️ GÜVENLİK SINIRI BU MODELDE:
///
///   `title`, `teaser`, `publishDate`  →  HERKESE AÇIK
///   `contentHtml`, `rawBlocks`        →  KİLİTLİ (yalnızca doğrulanmış oturum)
///
/// `teaser` gerçek içeriğin KESİLMİŞ HÂLİ DEĞİLDİR. Notion'daki ayrı bir
/// "Özet" alanından gelir ve kasıtlı yazılmış bir vitrin metnidir. Bu sayede
/// kilitli ekrana gerçek içeriğin tek baytı bile gitmez — sızıntı mümkün değil.
model Week {
  id String @id @default(cuid())

  campId Int
  camp   Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  /// 1'den başlar
  weekNumber Int

  /// Hafta başlığı — HERKESE AÇIK (müfredat özetinde görünür)
  title String

  /// Bulunduğu aşama/ay başlığı ("🔵 1. AŞAMA: Temeller ve Güçlü JavaScript")
  /// HERKESE AÇIK — müfredat özetinde gruplama için kullanılır.
  stage String?

  /// Vitrin metni — HERKESE AÇIK (kilitli ekranda gösterilir).
  ///
  /// Notion'da bilerek yazılmış bir `callout`/`quote` bloğu varsa otomatik
  /// doldurulur. Yoksa BOŞ KALIR ve admin panelinde doldurulması istenir —
  /// ders içeriğinin ilk paragrafı otomatik olarak buraya KOPYALANMAZ.
  teaser String @default("")

  /// Notion'dan çıkarılan özet ÖNERİSİ. `teaser` boşken admin paneline
  /// "şunu kullanmak ister misin?" diye sunulur. Kilitli ekrana ASLA gitmez.
  teaserSuggestion String?

  /// Önerinin kaynağı: "callout" | "quote" | "paragraph"
  /// "paragraph" ise bu gerçek ders içeriğidir — admin onayı olmadan
  /// kullanılmaz.
  teaserSource String?

  /// Tam içerik, HTML'e dönüştürülmüş — KİLİTLİ
  contentHtml String?

  /// Notion'dan gelen ham bloklar — KİLİTLİ. Yeniden render için saklanır.
  rawBlocks Json?

  status WeekStatus @default(DRAFT)

  /// Haftanın açılış tarihi — HERKESE AÇIK
  publishDate DateTime?

  /// Bu haftanın rozet görselinin IPFS CID'i (`bafy...`, `ipfs://` öneksiz).
  ///
  /// Görseller Faz 3'te üretilip Pinata'ya yüklenecek. Boşken metadata uç
  /// noktası yer tutucu bir görsel döner — NFT "bozuk" görünmez, sadece
  /// henüz tasarlanmamış görünür.
  imageCid String?

  // ---- Notion senkron durumu ----

  /// Notion'daki toggle bloğunun kimliği.
  /// Webhook geldiğinde hangi haftanın değiştiğini bulmak için kullanılır.
  notionBlockId String? @unique

  /// İçeriğin hash'i. Değişmemişse gereksiz yazma ve cache temizleme yapılmaz.
  contentHash String?

  /// Son BAŞARILI senkron zamanı
  syncedAt DateTime?

  syncStatus SyncStatus @default(PENDING)

  /// Son hatanın mesajı (admin panelinde gösterilir)
  lastError String?

  /// Son deneme zamanı (başarılı ya da değil)
  lastAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campId, weekNumber])
  @@index([campId, status])
}

// ============================================================================
//                           BAŞVURULAR (FAZ A)
// ============================================================================

enum ApplicationStatus {
  /// Bekliyor — admin panelinde onay/red kuyruğunda
  PENDING

  /// Onaylandı — `WeeklyCompletion` kayıtları üretildi
  APPROVED

  /// Reddedildi
  REJECTED
}

/// Geri doldurma başvurusu: "Ben bu kampın N. haftasındayım."
///
/// ⚠️ BU SİSTEMİN TEK GÜVEN NOKTASI.
/// Beyan edilen hafta hiçbir otomatik doğrulamadan geçmez — bilinçli bir
/// tercih. Admin (kulüp yöneticisi) her başvuruyu elle inceler ve onaylar.
/// Onay verilene kadar zincirde hiçbir şey olmaz.
model Application {
  id String @id @default(cuid())

  /// Cüzdan adresi — HER ZAMAN KÜÇÜK HARF saklanır.
  /// Gerekçe: Postgres'te büyük/küçük harf duyarlı karşılaştırma, aynı cüzdanın
  /// iki farklı kayıt oluşturmasına yol açar. Görüntülerken viem'in
  /// `getAddress()` fonksiyonu ile checksum'lı hâle çevrilir.
  address String

  campId Int
  camp   Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  /// Katılımcının beyan ettiği hafta. 1..camp.weekCount aralığında olmalı.
  declaredWeek Int

  /// Katılımcının seçtiği nick (henüz zincirde değil, sadece beyan).
  /// Zincire yazılması kullanıcının kendi işlemiyle olur.
  nickname String?

  /// Katılımcının notu ("3. haftadan katıldım, X arkadaşım referans")
  note String?

  status ApplicationStatus @default(PENDING)

  /// Onaylayan/reddeden admin adresi (küçük harf)
  reviewedBy String?

  reviewedAt DateTime?

  /// Adminin notu ("teyit edildi", "kayıt bulunamadı")
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bir kişi bir kampa yalnızca bir kez başvurabilir.
  /// Farklı kamplara ayrı ayrı başvurabilir (çift kayıt şartı).
  @@unique([address, campId])
  @@index([status, createdAt])
}

// ============================================================================
//                    HAFTA TAMAMLAMALARI (HAK EDİŞ LİSTESİ)
// ============================================================================

/// "Bu adres, bu kampın bu haftasını tamamladı" kaydı.
/// Merkle ağaçları DOĞRUDAN bu tablodan üretilir.
///
/// İki yoldan oluşur:
///   1. Geri doldurma onayı → beyan edilen hafta N ise 1..N için N kayıt
///   2. Haftalık işleyiş    → admin o haftayı tamamlayanları işaretler
model WeeklyCompletion {
  id String @id @default(cuid())

  /// Küçük harf adres
  address String

  campId Int
  camp   Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  weekNumber Int

  /// Kaydın kaynağı: "backfill" | "weekly" | "import"
  /// Denetim için tutulur — bir rozetin nereden geldiği her zaman izlenebilir.
  source String @default("weekly")

  /// Bu kaydı oluşturan admin adresi
  createdBy String?

  createdAt DateTime @default(now())

  @@unique([address, campId, weekNumber])
  @@index([campId, weekNumber])
  @@index([address])
}

// ============================================================================
//                              MERKLE AĞAÇLARI
// ============================================================================

/// Bir (kamp, hafta) için üretilmiş merkle ağacı.
///
/// Ağacın TAMAMI saklanır (`treeJson`). Gerekçe: proof üretmek için ağacın
/// yeniden kurulması gerekir. Her istekte tüm listeyi çekip ağacı baştan
/// kurmak yerine, `StandardMerkleTree.load()` ile hazır ağaç yüklenir.
///
/// Aynı (kamp, hafta) için birden fazla kayıt olabilir — listeye sonradan biri
/// eklenirse yeni bir ağaç üretilir. En son üretilen (`createdAt` en büyük)
/// geçerli olandır; zincire yazılan da odur.
model MerkleTree {
  id String @id @default(cuid())

  campId Int
  camp   Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  weekNumber Int

  /// 0x ile başlayan 32 baytlık kök
  root String

  /// `StandardMerkleTree.dump()` çıktısı — proof üretimi için
  treeJson Json

  /// Ağaçtaki yaprak sayısı (= hak eden kişi sayısı)
  entryCount Int

  /// Zincire yazıldıysa işlem hash'i. null ise henüz yayınlanmamış.
  txHash String?

  /// Zincire yazıldığı an
  publishedAt DateTime?

  /// Bu ağacı üreten admin adresi
  createdBy String?

  createdAt DateTime @default(now())

  @@index([campId, weekNumber, createdAt])
  @@index([root])
}

// ============================================================================
//                              SENKRON GÜNLÜĞÜ
// ============================================================================

/// Her Notion senkron denemesinin kaydı. Admin panelindeki
/// "son senkron ne zaman, başarılı mıydı" göstergesini besler.
model SyncRun {
  id String @id @default(cuid())

  /// Neyin tetiklediği: "webhook" | "cron" | "manual"
  trigger String

  /// Hedef: belirli bir kamp veya "all"
  scope String @default("all")

  /// Kaç hafta güncellendi
  updatedCount Int @default(0)

  /// Kaç hafta değişmemişti (hash aynı)
  unchangedCount Int @default(0)

  /// Kaç hafta hata verdi
  failedCount Int @default(0)

  /// Genel sonuç
  success Boolean @default(false)

  /// Hata özeti
  error String?

  /// Süre (ms)
  durationMs Int?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
}

// ============================================================================
//                            KATILIMCI PROFİLİ
// ============================================================================

/// Katılımcının kendisi hakkında verdiği, zincir dışı bilgiler.
///
/// NEDEN `Application` İÇİNDE DEĞİL, AYRI BİR MODEL:
/// Bir kişi birden fazla kampa başvurabilir (Faz 0 şartı). Üniversite ve
/// "siteyi nereden duydun" bilgileri KİŞİYE ait; başvuruya değil. Application
/// içinde tutulsaydı aynı sorular her başvuruda tekrar sorulur ve iki farklı
/// cevap kaydedilebilirdi.
///
/// Adres birincil anahtar: zincirdeki kimlik neyse, buradaki kayıt da ona bağlı.
model Participant {
  /// Cüzdan adresi — HER ZAMAN KÜÇÜK HARF (bkz. Application.address)
  address String @id

  /// Katılımcının üniversitesi.
  /// Listeden seçilirse o değer, "Diğer" seçilirse yazdığı metin saklanır.
  university String?

  /// Siteyi nereden duyduğu — SABİT seçeneklerden biri.
  /// Gruplayarak sayabilmek için ayrı tutuluyor (admin panelinde dağılım
  /// gösteriliyor); serbest metin olsaydı "instagram" / "Instagram" / "insta"
  /// üç ayrı satır olurdu.
  referralSource String?

  /// "Diğer" seçildiğinde yazdığı açıklama
  referralDetail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referralSource])
  @@index([university])
}

// ============================================================================
//                        ORTAK DERS NOTLARI (NOT DEFTERİ)
// ============================================================================

/// Bir notun türü.
///
/// NEDEN SERBEST DEĞİL DE DÖRT TÜR:
/// Notion'daki not defteri boş kaldı çünkü katkı verecek kişi boş bir sayfayla
/// karşılaşıyordu — "ne yazacağım?" sorusunun cevabı yoktu. Tür seçmek bu
/// soruyu ortadan kaldırır: her türün kendi yönergesi ve örneği var.
enum NoteKind {
  /// Anlamadığın bir terim/kavram ve öğrendiğin açıklaması
  TERIM

  /// Haftanın kendi cümlelerinle özeti
  OZET

  /// İşine yarayan bir kaynak (video, makale, dokümantasyon) ve NEDEN yaradığı
  KAYNAK

  /// Takıldığın nokta ve oradan nasıl çıktığın
  TUZAK
}

enum NoteStatus {
  /// Not defterinde görünür
  VISIBLE

  /// Yönetim gizledi (spam, yanlış bilgi). SİLİNMEZ — denetim izi kalsın.
  HIDDEN
}

/// Bir katılımcının bir hafta için bıraktığı ortak not.
///
/// ⚠️ BU TABLO KULLANICI ÜRETİMİ İÇERİK TUTAR — projedeki TEK yer.
/// `body` DÜZ METİNDİR, HTML DEĞİL. Ekranda React metin düğümü olarak basılır,
/// `dangerouslySetInnerHTML` ile ASLA. Bağlantılar render sırasında ayrı
/// `<a>` öğelerine dönüştürülür ve yalnızca http/https protokolüne izin verilir.
/// Bu ayrımı bozmak, siteyi XSS'e açar.
///
/// Hafta içeriği (`Week.contentHtml`) Notion'dan gelir ve denetimli bir
/// dönüştürücüden geçer; burası öyle değil — kaynağı doğrudan kullanıcıdır.
model WeekNote {
  id String @id @default(cuid())

  campId Int
  camp   Camp @relation(fields: [campId], references: [id], onDelete: Cascade)

  weekNumber Int

  /// Yazarın cüzdan adresi — KÜÇÜK HARF (bkz. Application.address)
  address String

  /// Yazarın nicki, YAZDIĞI ANDAKİ hâliyle.
  ///
  /// Neden zincirden okunmuyor: not defteri sayfası onlarca not gösterir;
  /// her not için zincire gitmek sayfayı saniyelerce bekletirdi. Nick
  /// değiştirilebildiği için bu bir anlık görüntüdür — kullanıcı notunu her
  /// güncellediğinde tazelenir.
  authorNickname String

  kind NoteKind

  /// Kısa başlık: "reentrancy tam olarak ne demek?"
  title String

  /// Notun kendisi. DÜZ METİN (yukarıdaki uyarıya bak).
  body String

  /// İsteğe bağlı kaynak bağlantısı. Yalnızca http/https kabul edilir.
  sourceUrl String?

  /// "Bu açıklamayı bir yapay zekâya sordum" işareti.
  ///
  /// Neden ayrı bir alan: kamp katılımcısı yapay zekâdan aldığı cevabı
  /// buraya yapıştırdığında, okuyan kişi bunun bir insanın deneyimi mi yoksa
  /// bir modelin açıklaması mı olduğunu bilmeli. İkisi de değerli ama aynı
  /// şey değil — model yanılabilir.
  aiAssisted Boolean @default(false)

  status NoteStatus @default(VISIBLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Not defteri sayfasının ana sorgusu
  @@index([campId, weekNumber, status, createdAt])
  /// "Bu kişi bu hafta için not yazmış mı?" — mint kapısının sorgusu
  @@index([address, campId, weekNumber])
}
