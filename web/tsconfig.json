{
  "compilerOptions": {
    // ES2020: tokenId hesabında `bigint` sabitleri (65539n) kullanılıyor.
    // Bunlar ES2020 öncesinde derlenmez. `number` kullanmak seçenek değil —
    // (campId << 16) işlemi güvenli tamsayı sınırını aşabilir ve sessiz
    // yuvarlama hatası üretir.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
