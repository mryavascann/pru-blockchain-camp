# ============================================================================
# PRU Blockchain Kulübü — git yok sayma listesi
# Kural: sır içeren HİÇBİR dosya repoya girmez.
# ============================================================================

# ---- Sırlar (en kritik bölüm) ----
.env
.env.*
!.env.example
*.key
*.pem
secrets/
keystore/

# ---- Foundry ----
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/docs/

# NOT: `contracts/lib/` BİLİNÇLİ olarak yok sayılmıyor.
# Bağımlılıklar git submodule olarak eklendi; .gitmodules ve submodule
# işaretçileri repoda durur. Böylece projeyi klonlayan herkes OpenZeppelin'in
# TAM OLARAK aynı sürümünü alır. Kontrat projelerinde bu kritik: farklı bir OZ
# sürümü farklı bytecode üretir ve deploy edilmiş kontratla doğrulama tutmaz.
#
# `broadcast/` deploy geçmişini tutar; içinde RPC URL ve adresler olabilir.
# `cache/` içinde Foundry'nin "sensitive values" dosyaları var — asla commit edilmez.

# ---- Node / Next.js ----
node_modules/
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ---- Prisma ----
web/prisma/*.db
web/prisma/*.db-journal

# Üretilen Prisma istemcisi — şemadan yeniden üretilir, repoda durmaz.
# Klonlayan kişi `npx prisma generate` çalıştırır.
web/lib/generated/

# ---- Test / kapsam çıktıları ----
coverage/
lcov.info
*.lcov

# ---- Editör / işletim sistemi ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Görseller: kaynak dosyalar repoya girmez, çıktılar girer ----
art/*.psd
art/*.ai
art/*.fig
art/**/kaynak/

# ---- Loglar ----
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
